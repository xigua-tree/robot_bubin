  32:Core/Src/MahonyAHRS.c **** // Variable definitions
  33:Core/Src/MahonyAHRS.c **** 
  34:Core/Src/MahonyAHRS.c **** volatile float twoKp = twoKpDef;											// 2 * proportional gain (Kp)
  35:Core/Src/MahonyAHRS.c **** volatile float twoKi = twoKiDef;											// 2 * integral gain (Ki)
  36:Core/Src/MahonyAHRS.c **** volatile float q0 = 1.0f, q1 = 0.0f, q2 = 0.0f, q3 = 0.0f;				// quaternion of sensor frame relativ
  37:Core/Src/MahonyAHRS.c **** volatile float integralFBx = 0.0f,  integralFBy = 0.0f, integralFBz = 0.0f;	// integral error terms
  38:Core/Src/MahonyAHRS.c **** float INS_quat[4];                                                          // quaternion array for
  39:Core/Src/MahonyAHRS.c **** 
