   5:Core/Src/MahonyAHRS.c **** // Madgwick's implementation of Mayhony's AHRS algorithm.
   6:Core/Src/MahonyAHRS.c **** // See: http://www.x-io.co.uk/node/8#open_source_ahrs_and_imu_algorithms
   7:Core/Src/MahonyAHRS.c **** //
