  46:Core/Src/MahonyAHRS.c **** // Functions
  47:Core/Src/MahonyAHRS.c **** 
  48:Core/Src/MahonyAHRS.c **** //-------------------------------------------------------------------------------------------------
  49:Core/Src/MahonyAHRS.c **** // AHRS algorithm update
  50:Core/Src/MahonyAHRS.c **** 
  51:Core/Src/MahonyAHRS.c **** void MahonyAHRSupdate(float q[4], float gx, float gy, float gz, float ax, float ay, float az, float
  52:Core/Src/MahonyAHRS.c **** 	float recipNorm;
  53:Core/Src/MahonyAHRS.c ****     float q0q0, q0q1, q0q2, q0q3, q1q1, q1q2, q1q3, q2q2, q2q3, q3q3;  
  54:Core/Src/MahonyAHRS.c **** 	float hx, hy, bx, bz;
  55:Core/Src/MahonyAHRS.c **** 	float halfvx, halfvy, halfvz, halfwx, halfwy, halfwz;
  56:Core/Src/MahonyAHRS.c **** 	float halfex, halfey, halfez;
  57:Core/Src/MahonyAHRS.c **** 	float qa, qb, qc;
  58:Core/Src/MahonyAHRS.c **** 
  59:Core/Src/MahonyAHRS.c **** 	// Use IMU algorithm if magnetometer measurement invalid (avoids NaN in magnetometer normalisation
  60:Core/Src/MahonyAHRS.c **** 	if((mx == 0.0f) && (my == 0.0f) && (mz == 0.0f)) {
  61:Core/Src/MahonyAHRS.c **** 		MahonyAHRSupdateIMU(q, gx, gy, gz, ax, ay, az);
  62:Core/Src/MahonyAHRS.c **** 		return;
  63:Core/Src/MahonyAHRS.c **** 	}
  64:Core/Src/MahonyAHRS.c **** 
  65:Core/Src/MahonyAHRS.c **** 	// Compute feedback only if accelerometer measurement valid (avoids NaN in accelerometer normalisa
  66:Core/Src/MahonyAHRS.c **** 	if(!((ax == 0.0f) && (ay == 0.0f) && (az == 0.0f))) {
  67:Core/Src/MahonyAHRS.c **** 
  68:Core/Src/MahonyAHRS.c **** 		// Normalise accelerometer measurement
  69:Core/Src/MahonyAHRS.c **** 		recipNorm = invSqrt(ax * ax + ay * ay + az * az);
  70:Core/Src/MahonyAHRS.c **** 		ax *= recipNorm;
  71:Core/Src/MahonyAHRS.c **** 		ay *= recipNorm;
  72:Core/Src/MahonyAHRS.c **** 		az *= recipNorm;     
  73:Core/Src/MahonyAHRS.c **** 
  74:Core/Src/MahonyAHRS.c **** 		// Normalise magnetometer measurement
  75:Core/Src/MahonyAHRS.c **** 		recipNorm = invSqrt(mx * mx + my * my + mz * mz);
  76:Core/Src/MahonyAHRS.c **** 		mx *= recipNorm;
  77:Core/Src/MahonyAHRS.c **** 		my *= recipNorm;
  78:Core/Src/MahonyAHRS.c **** 		mz *= recipNorm;   
  79:Core/Src/MahonyAHRS.c **** 
  80:Core/Src/MahonyAHRS.c ****         // Auxiliary variables to avoid repeated arithmetic
  81:Core/Src/MahonyAHRS.c ****         q0q0 = q[0] * q[0];
  82:Core/Src/MahonyAHRS.c ****         q0q1 = q[0] * q[1];
  83:Core/Src/MahonyAHRS.c ****         q0q2 = q[0] * q[2];
  84:Core/Src/MahonyAHRS.c ****         q0q3 = q[0] * q[3];
  85:Core/Src/MahonyAHRS.c ****         q1q1 = q[1] * q[1];
  86:Core/Src/MahonyAHRS.c ****         q1q2 = q[1] * q[2];
ARM GAS  C:\Users\10369\AppData\Local\Temp\ccTzk2qh.s 			page 3


  87:Core/Src/MahonyAHRS.c ****         q1q3 = q[1] * q[3];
  88:Core/Src/MahonyAHRS.c ****         q2q2 = q[2] * q[2];
  89:Core/Src/MahonyAHRS.c ****         q2q3 = q[2] * q[3];
  90:Core/Src/MahonyAHRS.c ****         q3q3 = q[3] * q[3];   
  91:Core/Src/MahonyAHRS.c **** 
  92:Core/Src/MahonyAHRS.c ****         // Reference direction of Earth's magnetic field
  93:Core/Src/MahonyAHRS.c ****         hx = 2.0f * (mx * (0.5f - q2q2 - q3q3) + my * (q1q2 - q0q3) + mz * (q1q3 + q0q2));
  94:Core/Src/MahonyAHRS.c ****         hy = 2.0f * (mx * (q1q2 + q0q3) + my * (0.5f - q1q1 - q3q3) + mz * (q2q3 - q0q1));
  95:Core/Src/MahonyAHRS.c ****         bx = sqrt(hx * hx + hy * hy);
  96:Core/Src/MahonyAHRS.c ****         bz = 2.0f * (mx * (q1q3 - q0q2) + my * (q2q3 + q0q1) + mz * (0.5f - q1q1 - q2q2));
  97:Core/Src/MahonyAHRS.c **** 
  98:Core/Src/MahonyAHRS.c **** 		// Estimated direction of gravity and magnetic field
  99:Core/Src/MahonyAHRS.c **** 		halfvx = q1q3 - q0q2;
 100:Core/Src/MahonyAHRS.c **** 		halfvy = q0q1 + q2q3;
 101:Core/Src/MahonyAHRS.c **** 		halfvz = q0q0 - 0.5f + q3q3;
 102:Core/Src/MahonyAHRS.c ****         halfwx = bx * (0.5f - q2q2 - q3q3) + bz * (q1q3 - q0q2);
 103:Core/Src/MahonyAHRS.c ****         halfwy = bx * (q1q2 - q0q3) + bz * (q0q1 + q2q3);
 104:Core/Src/MahonyAHRS.c ****         halfwz = bx * (q0q2 + q1q3) + bz * (0.5f - q1q1 - q2q2);  
 105:Core/Src/MahonyAHRS.c **** 	
 106:Core/Src/MahonyAHRS.c **** 		// Error is sum of cross product between estimated direction and measured direction of field vect
 107:Core/Src/MahonyAHRS.c **** 		halfex = (ay * halfvz - az * halfvy) + (my * halfwz - mz * halfwy);
 108:Core/Src/MahonyAHRS.c **** 		halfey = (az * halfvx - ax * halfvz) + (mz * halfwx - mx * halfwz);
 109:Core/Src/MahonyAHRS.c **** 		halfez = (ax * halfvy - ay * halfvx) + (mx * halfwy - my * halfwx);
 110:Core/Src/MahonyAHRS.c **** 
 111:Core/Src/MahonyAHRS.c **** 		// Compute and apply integral feedback if enabled
 112:Core/Src/MahonyAHRS.c **** 		if(twoKi > 0.0f) {
 113:Core/Src/MahonyAHRS.c **** 			integralFBx += twoKi * halfex * (1.0f / sampleFreq);	// integral error scaled by Ki
 114:Core/Src/MahonyAHRS.c **** 			integralFBy += twoKi * halfey * (1.0f / sampleFreq);
 115:Core/Src/MahonyAHRS.c **** 			integralFBz += twoKi * halfez * (1.0f / sampleFreq);
 116:Core/Src/MahonyAHRS.c **** 			gx += integralFBx;	// apply integral feedback
 117:Core/Src/MahonyAHRS.c **** 			gy += integralFBy;
 118:Core/Src/MahonyAHRS.c **** 			gz += integralFBz;
 119:Core/Src/MahonyAHRS.c **** 		}
 120:Core/Src/MahonyAHRS.c **** 		else {
 121:Core/Src/MahonyAHRS.c **** 			integralFBx = 0.0f;	// prevent integral windup
 122:Core/Src/MahonyAHRS.c **** 			integralFBy = 0.0f;
 123:Core/Src/MahonyAHRS.c **** 			integralFBz = 0.0f;
 124:Core/Src/MahonyAHRS.c **** 		}
 125:Core/Src/MahonyAHRS.c **** 
 126:Core/Src/MahonyAHRS.c **** 		// Apply proportional feedback
 127:Core/Src/MahonyAHRS.c **** 		gx += twoKp * halfex;
 128:Core/Src/MahonyAHRS.c **** 		gy += twoKp * halfey;
 129:Core/Src/MahonyAHRS.c **** 		gz += twoKp * halfez;
 130:Core/Src/MahonyAHRS.c **** 	}
 131:Core/Src/MahonyAHRS.c **** 	
 132:Core/Src/MahonyAHRS.c **** 	// Integrate rate of change of quaternion
 133:Core/Src/MahonyAHRS.c **** 	gx *= (0.5f * (1.0f / sampleFreq));		
 134:Core/Src/MahonyAHRS.c **** 	gy *= (0.5f * (1.0f / sampleFreq));
 135:Core/Src/MahonyAHRS.c **** 	gz *= (0.5f * (1.0f / sampleFreq));
 136:Core/Src/MahonyAHRS.c **** 	qa = q[0];
 137:Core/Src/MahonyAHRS.c **** 	qb = q[1];
 138:Core/Src/MahonyAHRS.c **** 	qc = q[2];
 139:Core/Src/MahonyAHRS.c **** 	q[0] += (-qb * gx - qc * gy - q[3] * gz);
 140:Core/Src/MahonyAHRS.c **** 	q[1] += (qa * gx + qc * gz - q[3] * gy);
 141:Core/Src/MahonyAHRS.c **** 	q[2] += (qa * gy - qb * gz + q[3] * gx);
 142:Core/Src/MahonyAHRS.c **** 	q[3] += (qa * gz + qb * gy - qc * gx); 
 143:Core/Src/MahonyAHRS.c **** 	
ARM GAS  C:\Users\10369\AppData\Local\Temp\ccTzk2qh.s 			page 4


 144:Core/Src/MahonyAHRS.c **** 	// Normalise quaternion
 145:Core/Src/MahonyAHRS.c **** 	recipNorm = invSqrt(q[0] * q[0] + q[1] * q[1] + q[2] * q[2] + q[3] * q[3]);
 146:Core/Src/MahonyAHRS.c **** 	q[0] *= recipNorm;
 147:Core/Src/MahonyAHRS.c **** 	q[1] *= recipNorm;
 148:Core/Src/MahonyAHRS.c **** 	q[2] *= recipNorm;
 149:Core/Src/MahonyAHRS.c **** 	q[3] *= recipNorm;
 150:Core/Src/MahonyAHRS.c **** }
 151:Core/Src/MahonyAHRS.c **** 
 152:Core/Src/MahonyAHRS.c **** //-------------------------------------------------------------------------------------------------
 153:Core/Src/MahonyAHRS.c **** // IMU algorithm update
 154:Core/Src/MahonyAHRS.c **** 
 155:Core/Src/MahonyAHRS.c **** void MahonyAHRSupdateIMU(float q[4], float gx, float gy, float gz, float ax, float ay, float az) {
 156:Core/Src/MahonyAHRS.c **** 	float recipNorm;
 157:Core/Src/MahonyAHRS.c **** 	float halfvx, halfvy, halfvz;
 158:Core/Src/MahonyAHRS.c **** 	float halfex, halfey, halfez;
 159:Core/Src/MahonyAHRS.c **** 	float qa, qb, qc;
 160:Core/Src/MahonyAHRS.c **** 
 161:Core/Src/MahonyAHRS.c **** 	// Compute feedback only if accelerometer measurement valid (avoids NaN in accelerometer normalisa
 162:Core/Src/MahonyAHRS.c **** 	if(!((ax == 0.0f) && (ay == 0.0f) && (az == 0.0f))) {
 163:Core/Src/MahonyAHRS.c **** 
 164:Core/Src/MahonyAHRS.c **** 		// Normalise accelerometer measurement
 165:Core/Src/MahonyAHRS.c **** 		recipNorm = invSqrt(ax * ax + ay * ay + az * az);
 166:Core/Src/MahonyAHRS.c **** 		ax *= recipNorm;
 167:Core/Src/MahonyAHRS.c **** 		ay *= recipNorm;
 168:Core/Src/MahonyAHRS.c **** 		az *= recipNorm;        
 169:Core/Src/MahonyAHRS.c **** 
 170:Core/Src/MahonyAHRS.c **** 		// Estimated direction of gravity and vector perpendicular to magnetic flux
 171:Core/Src/MahonyAHRS.c **** 		halfvx = q[1] * q[3] - q[0] * q[2];
 172:Core/Src/MahonyAHRS.c **** 		halfvy = q[0] * q[1] + q[2] * q[3];
 173:Core/Src/MahonyAHRS.c **** 		halfvz = q[0] * q[0] - 0.5f + q[3] * q[3];
 174:Core/Src/MahonyAHRS.c **** 	
 175:Core/Src/MahonyAHRS.c **** 		// Error is sum of cross product between estimated and measured direction of gravity
 176:Core/Src/MahonyAHRS.c **** 		halfex = (ay * halfvz - az * halfvy);
 177:Core/Src/MahonyAHRS.c **** 		halfey = (az * halfvx - ax * halfvz);
 178:Core/Src/MahonyAHRS.c **** 		halfez = (ax * halfvy - ay * halfvx);
 179:Core/Src/MahonyAHRS.c **** 
 180:Core/Src/MahonyAHRS.c **** 		// Compute and apply integral feedback if enabled
 181:Core/Src/MahonyAHRS.c **** 		if(twoKi > 0.0f) {
 182:Core/Src/MahonyAHRS.c **** 			integralFBx += twoKi * halfex * (1.0f / sampleFreq);	// integral error scaled by Ki
 183:Core/Src/MahonyAHRS.c **** 			integralFBy += twoKi * halfey * (1.0f / sampleFreq);
 184:Core/Src/MahonyAHRS.c **** 			integralFBz += twoKi * halfez * (1.0f / sampleFreq);
 185:Core/Src/MahonyAHRS.c **** 			gx += integralFBx;	// apply integral feedback
 186:Core/Src/MahonyAHRS.c **** 			gy += integralFBy;
 187:Core/Src/MahonyAHRS.c **** 			gz += integralFBz;
 188:Core/Src/MahonyAHRS.c **** 		}
 189:Core/Src/MahonyAHRS.c **** 		else {
 190:Core/Src/MahonyAHRS.c **** 			integralFBx = 0.0f;	// prevent integral windup
 191:Core/Src/MahonyAHRS.c **** 			integralFBy = 0.0f;
 192:Core/Src/MahonyAHRS.c **** 			integralFBz = 0.0f;
 193:Core/Src/MahonyAHRS.c **** 		}
 194:Core/Src/MahonyAHRS.c **** 
 195:Core/Src/MahonyAHRS.c **** 		// Apply proportional feedback
 196:Core/Src/MahonyAHRS.c **** 		gx += twoKp * halfex;
 197:Core/Src/MahonyAHRS.c **** 		gy += twoKp * halfey;
 198:Core/Src/MahonyAHRS.c **** 		gz += twoKp * halfez;
 199:Core/Src/MahonyAHRS.c **** 	}
 200:Core/Src/MahonyAHRS.c **** 	
ARM GAS  C:\Users\10369\AppData\Local\Temp\ccTzk2qh.s 			page 5


 201:Core/Src/MahonyAHRS.c **** 	// Integrate rate of change of quaternion
 202:Core/Src/MahonyAHRS.c **** 	gx *= (0.5f * (1.0f / sampleFreq));		// pre-multiply common factors
 203:Core/Src/MahonyAHRS.c **** 	gy *= (0.5f * (1.0f / sampleFreq));
 204:Core/Src/MahonyAHRS.c **** 	gz *= (0.5f * (1.0f / sampleFreq));
 205:Core/Src/MahonyAHRS.c **** 	qa = q[0];
 206:Core/Src/MahonyAHRS.c **** 	qb = q[1];
 207:Core/Src/MahonyAHRS.c **** 	qc = q[2];
 208:Core/Src/MahonyAHRS.c **** 	q[0] += (-qb * gx - qc * gy - q[3] * gz);
 209:Core/Src/MahonyAHRS.c **** 	q[1] += (qa * gx + qc * gz - q[3] * gy);
 210:Core/Src/MahonyAHRS.c **** 	q[2] += (qa * gy - qb * gz + q[3] * gx);
 211:Core/Src/MahonyAHRS.c **** 	q[3] += (qa * gz + qb * gy - qc * gx); 
 212:Core/Src/MahonyAHRS.c **** 	
 213:Core/Src/MahonyAHRS.c **** 	// Normalise quaternion
 214:Core/Src/MahonyAHRS.c **** 	recipNorm = invSqrt(q[0] * q[0] + q[1] * q[1] + q[2] * q[2] + q[3] * q[3]);
 215:Core/Src/MahonyAHRS.c **** 	q[0] *= recipNorm;
 216:Core/Src/MahonyAHRS.c **** 	q[1] *= recipNorm;
 217:Core/Src/MahonyAHRS.c **** 	q[2] *= recipNorm;
 218:Core/Src/MahonyAHRS.c **** 	q[3] *= recipNorm;
 219:Core/Src/MahonyAHRS.c **** }
 220:Core/Src/MahonyAHRS.c **** 
