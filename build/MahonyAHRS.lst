  21:Core/Src/MahonyAHRS.c **** // Definitions
  22:Core/Src/MahonyAHRS.c **** // Mahony AHRS 参数 (适配 MPU6050)
  23:Core/Src/MahonyAHRS.c **** #define sampleFreq    200.0f			// 必须与实际调用频率一致 (main.c 中每5ms调用一次)
  24:Core/Src/MahonyAHRS.c **** #define twoKpDef      1.0f			// 2*比例增益 (MPU6050 噪声较大，需要较高增益)
  25:Core/Src/MahonyAHRS.c **** #define twoKiDef      0.01f			// 2*积分增益 (用于估计陀螺仪零偏)
  26:Core/Src/MahonyAHRS.c **** 
  27:Core/Src/MahonyAHRS.c **** //#define sampleFreq	1000.0f			// sample frequency in Hz
  28:Core/Src/MahonyAHRS.c **** //#define twoKpDef	0.5f
  29:Core/Src/MahonyAHRS.c **** //#define twoKiDef	0.001f
