 128:Core/Src/nrf24l01.c **** /**
 129:Core/Src/nrf24l01.c ****  * @brief       NRF24L01写寄存器
 130:Core/Src/nrf24l01.c ****  * @param       reg   : 寄存器地址
 131:Core/Src/nrf24l01.c ****  * @param       value : 写入寄存器的值
 132:Core/Src/nrf24l01.c ****  * @retval      状态寄存器值
 133:Core/Src/nrf24l01.c ****  */
 134:Core/Src/nrf24l01.c **** static uint8_t nrf24l01_write_reg(uint8_t reg, uint8_t value)
 135:Core/Src/nrf24l01.c **** {
 136:Core/Src/nrf24l01.c ****     uint8_t status;
 137:Core/Src/nrf24l01.c **** 
 138:Core/Src/nrf24l01.c ****     NRF24L01_CSN(0);                    /* 使能SPI传输 */
 139:Core/Src/nrf24l01.c ****     status = spi2_read_write_byte(reg); /* 发送寄存器号 */
 140:Core/Src/nrf24l01.c ****     spi2_read_write_byte(value);        /* 写入寄存器的值 */
 141:Core/Src/nrf24l01.c ****     NRF24L01_CSN(1);                    /* 禁止SPI传输 */
 142:Core/Src/nrf24l01.c **** 
 143:Core/Src/nrf24l01.c ****     return status;                      /* 返回状态值 */
 144:Core/Src/nrf24l01.c **** }
 145:Core/Src/nrf24l01.c **** 
 146:Core/Src/nrf24l01.c **** /**
 147:Core/Src/nrf24l01.c ****  * @brief       NRF24L01读寄存器
 148:Core/Src/nrf24l01.c ****  * @param       reg   : 寄存器地址
 149:Core/Src/nrf24l01.c ****  * @retval      读取到的寄存器值;
 150:Core/Src/nrf24l01.c ****  */
 151:Core/Src/nrf24l01.c **** static uint8_t nrf24l01_read_reg(uint8_t reg)
 152:Core/Src/nrf24l01.c **** {
 153:Core/Src/nrf24l01.c ****     uint8_t reg_val;
 154:Core/Src/nrf24l01.c **** 
 155:Core/Src/nrf24l01.c ****     NRF24L01_CSN(0);            /* 使能SPI传输 */
 156:Core/Src/nrf24l01.c ****     spi2_read_write_byte(reg);  /* 发送寄存器号 */
 157:Core/Src/nrf24l01.c ****     reg_val = spi2_read_write_byte(0XFF);   /* 读取寄存器内容 */
 158:Core/Src/nrf24l01.c ****     NRF24L01_CSN(1);            /* 禁止SPI传输 */
 159:Core/Src/nrf24l01.c **** 
 160:Core/Src/nrf24l01.c ****     return reg_val;             /* 返回状态值 */
 161:Core/Src/nrf24l01.c **** }
 162:Core/Src/nrf24l01.c **** 
 163:Core/Src/nrf24l01.c **** /**
 164:Core/Src/nrf24l01.c ****  * @brief       在指定位置读出指定长度的数据
