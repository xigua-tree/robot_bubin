 104:Core/Src/nrf24l01.c **** /**
 105:Core/Src/nrf24l01.c ****  * @brief       检测24L01是否存在
 106:Core/Src/nrf24l01.c ****  * @param       无
 107:Core/Src/nrf24l01.c ****  * @retval      0, 成功; 1, 失败;
 108:Core/Src/nrf24l01.c ****  */
 109:Core/Src/nrf24l01.c **** uint8_t nrf24l01_check(void)
 110:Core/Src/nrf24l01.c **** {
 111:Core/Src/nrf24l01.c ****     uint8_t buf[5] = {0XA5, 0XA5, 0XA5, 0XA5, 0XA5};
ARM GAS  C:\Users\10369\AppData\Local\Temp\ccXOKF2c.s 			page 5


 112:Core/Src/nrf24l01.c ****     uint8_t i;
 113:Core/Src/nrf24l01.c **** 
 114:Core/Src/nrf24l01.c ****     spi2_set_speed(SPI_BAUDRATEPRESCALER_32);                /* spi速度为7.5Mhz(24L01的最大SP
 115:Core/Src/nrf24l01.c ****     nrf24l01_write_buf(NRF_WRITE_REG + TX_ADDR, buf, 5);  /* 写入5个字节的地址. */
 116:Core/Src/nrf24l01.c ****     nrf24l01_read_buf(TX_ADDR, buf, 5);                   /* 读出写入的地址 */
 117:Core/Src/nrf24l01.c **** 
 118:Core/Src/nrf24l01.c ****     for (i = 0; i < 5; i++)
 119:Core/Src/nrf24l01.c ****     {
 120:Core/Src/nrf24l01.c ****         if (buf[i] != 0XA5) break;
 121:Core/Src/nrf24l01.c ****     }
 122:Core/Src/nrf24l01.c **** 
 123:Core/Src/nrf24l01.c ****     if (i != 5) return 1;   /* 检测24L01错误 */
 124:Core/Src/nrf24l01.c **** 
 125:Core/Src/nrf24l01.c ****     return 0;               /* 检测到24L01 */
 126:Core/Src/nrf24l01.c **** }
