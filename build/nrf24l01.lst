ARM GAS  C:\Users\10369\AppData\Local\Temp\ccXOKF2c.s 			page 6


 169:Core/Src/nrf24l01.c ****  */
 170:Core/Src/nrf24l01.c **** static uint8_t nrf24l01_read_buf(uint8_t reg, uint8_t *pbuf, uint8_t len)
 171:Core/Src/nrf24l01.c **** {
 172:Core/Src/nrf24l01.c ****     uint8_t status, i;
 173:Core/Src/nrf24l01.c **** 
 174:Core/Src/nrf24l01.c ****     NRF24L01_CSN(0);                            /* 使能SPI传输 */
 175:Core/Src/nrf24l01.c ****     status = spi2_read_write_byte(reg);         /* 发送寄存器值(位置),并读取状态值 */
 176:Core/Src/nrf24l01.c **** 
 177:Core/Src/nrf24l01.c ****     for (i = 0; i < len; i++)
 178:Core/Src/nrf24l01.c ****     {
 179:Core/Src/nrf24l01.c ****         pbuf[i] = spi2_read_write_byte(0XFF);   /* 读取数据 */
 180:Core/Src/nrf24l01.c ****     }
 181:Core/Src/nrf24l01.c **** 
 182:Core/Src/nrf24l01.c ****     NRF24L01_CSN(1);    /* 关闭SPI传输 */
 183:Core/Src/nrf24l01.c **** 
 184:Core/Src/nrf24l01.c ****     return status;      /* 返回读到的状态值 */
 185:Core/Src/nrf24l01.c **** }
