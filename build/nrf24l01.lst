  62:Core/Src/nrf24l01.c **** {
  63:Core/Src/nrf24l01.c ****     /* NRF24L01 要求 SPI Mode 0: CPOL=0, CPHA=0 (第1个边沿采样).
  64:Core/Src/nrf24l01.c ****      * 项目的 MX_SPI2_Init() 已配置 CPOL=LOW, CPHA=1EDGE,
  65:Core/Src/nrf24l01.c ****      * 只需确保速度不超过 10MHz 即可. 使用8分频: 42MHz/8 = 5.25MHz */
  66:Core/Src/nrf24l01.c ****     spi2_set_speed(SPI_BAUDRATEPRESCALER_8);
  67:Core/Src/nrf24l01.c **** }
  68:Core/Src/nrf24l01.c **** 
